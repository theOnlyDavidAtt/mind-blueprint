# --- AI report (server only) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Paywall (Whop) ---
# Whop dashboard -> Developer -> Company API key (read access to payments). Server only, never share it.
WHOP_API_KEY=
# Your product id (prod_...), so only payments for THIS product unlock the report.
WHOP_PRODUCT_ID=
# Your plan id (plan_...) for the embedded checkout. Public value.
NEXT_PUBLIC_WHOP_PLAN_ID=
# Price text on the button. Avoid a "$" sign here (env files treat it specially), e.g. "20 USD". Empty = shows $20.
NEXT_PUBLIC_PRICE_LABEL=20 USD
# 32+ random characters. Create one with: openssl rand -base64 32   (or any long random string)
SESSION_SECRET=

# Local testing only (ignored in production): skip the paywall
# DEV_UNLOCK=true
